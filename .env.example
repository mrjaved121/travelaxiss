# Canonical site URL used in metadata, sitemap, and JSON-LD. Defaults to
# https://travelaxis.me if unset.
NEXT_PUBLIC_SITE_URL=https://travelaxis.me

# GA4 measurement ID (Admin > Data Streams > your web stream, in GA4).
# Static export bakes this in at build time — it must be set before
# running `next build`, not just at deploy time. Leave unset in local dev
# so analytics never fires against production data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
