# Canonical site URL used in metadata, sitemap, and JSON-LD. Defaults to
# https://travelaxis.me if unset.
NEXT_PUBLIC_SITE_URL=https://travelaxis.me

# Analytics: Google Tag Manager (GTM-PK45Z389) is loaded from app/layout.tsx and
# GA4 runs inside that container. There is no GA4 env var: do not add a direct
# gtag.js snippet, it would double count page views.
